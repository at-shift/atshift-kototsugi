msgstr "Das externe Bild hat eine unerwartete Antwort zurückgegeben."

msgid "The remote image exceeds the upload size limit."
msgstr "Das externe Bild überschreitet die zulässige Uploadgröße."

msgid "The downloaded file is not a supported image."
msgstr "Die heruntergeladene Datei hat kein unterstütztes Bildformat."

msgid ".md / .markdown / .txt, up to 2 MB"
msgstr ".md / .markdown / .txt, bis zu 2 MB"

msgid "Choose a .md, .markdown, or .txt file up to 2 MB."
msgstr "Wählen Sie eine Datei im Format .md, .markdown oder .txt mit höchstens 2 MB aus."

msgid "Copy AI authoring rules"
msgstr "KI-Schreibregeln kopieren"

