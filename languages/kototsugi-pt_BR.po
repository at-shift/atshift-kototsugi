msgstr "Aplicar categorias"

msgid "Add at cursor"
msgstr "Adicionar na posição do cursor"

msgid "Copying..."
msgstr "Copiando..."

msgid "The closing ``` for the code block was not found."
msgstr "O ``` de fechamento do bloco de código não foi encontrado."

msgid "Slug"
msgstr "Slug"

msgid "Apply slug"
msgstr "Aplicar slug"

msgid "Loading sample..."
msgstr "Carregando exemplo..."

msgid "Title"
msgstr "Título"

msgid "Tags"
msgstr "Tags"

msgid "Apply tags"
msgstr "Aplicar tags"

msgid "Task lists will be converted to regular lists without preserving checkbox states."
msgstr "As listas de tarefas serão convertidas em listas comuns, sem manter o estado das caixas de seleção."

msgid "Sample Markdown loaded."
msgstr "Exemplo de Markdown carregado."

msgid "Sample Markdown could not be loaded."
msgstr "Não foi possível carregar o exemplo de Markdown."

msgid "Load sample Markdown"
msgstr "Carregar Markdown de exemplo"

msgid "Nested lists will be flattened to one level."
msgstr "Listas aninhadas serão reduzidas a um único nível."

msgid "The file could not be read."
msgstr "Não foi possível ler o arquivo."

msgid "Choose file"
msgstr "Escolher arquivo"

msgid "Insert as blocks"
msgstr "Inserir como blocos"

msgid "Blocks were inserted at the current cursor position."
msgstr "Os blocos foram inseridos na posição atual do cursor."

msgid "Preview"
msgstr "Pré-visualização"

msgid "There is no source to preview."
msgstr "Não há texto para pré-visualizar."

msgid "Some post settings could not be applied for this post type or with your current permissions."
msgstr "Algumas configurações da publicação não puderam ser aplicadas a este tipo de conteúdo ou com suas permissões atuais."

msgid "Some images or post settings could not be applied."
msgstr "Algumas imagens ou configurações da publicação não puderam ser aplicadas."

msgid "The draft was created, but not all conversion steps could be completed. "
msgstr "O rascunho foi criado, mas nem todas as etapas de conversão puderam ser concluídas. "

msgid "Open draft"
msgstr "Abrir rascunho"

msgid "Alt text"
msgstr "Texto alternativo"

msgid " items"
msgstr " itens"

msgid " categories or tags were created."
msgstr " categorias ou tags foram criadas."

msgid " remote images will be saved to the Media Library."
msgstr " imagens remotas serão salvas na Biblioteca de Mídia."

msgid " post settings were applied."
msgstr " configurações da publicação foram aplicadas."

msgid " existing blocks will be replaced in the editor."
msgstr " blocos existentes serão substituídos no editor."

msgid " existing blocks: confirm replacement"
msgstr " blocos existentes: confirmar substituição"

msgid " images could not be saved, so their remote URLs were kept in the post."
msgstr " imagens não puderam ser salvas; por isso, suas URLs remotas foram mantidas na publicação."

msgid " images were saved to the Media Library."
msgstr " imagens foram salvas na Biblioteca de Mídia."

msgid " items to review"
msgstr " itens para revisar"

msgid " settings to apply"
msgstr " configurações para aplicar"

