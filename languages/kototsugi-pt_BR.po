msgid "Used on the passphrase, article, review, and completion screens."
msgstr "Este idioma será usado nas telas de senha de acesso, artigo, revisão e conclusão."

msgid "New article"
msgstr "Novo artigo"

msgid "Create an article"
msgstr "Criar um artigo"

msgid "Article title"
msgstr "Título do artigo"

msgid "Article text"
msgstr "Texto do artigo"

msgid "Write the article here"
msgstr "Escreva o artigo aqui"

msgid "Writing hints"
msgstr "Dicas para escrever"

msgid "Writing normally creates paragraphs. Use these hints only when you want more structure."
msgstr "Escreva normalmente para criar parágrafos. Use estas dicas somente quando quiser organizar melhor o conteúdo."

msgid "Leave a blank line between paragraphs."
msgstr "Deixe uma linha em branco entre os parágrafos."

msgid "Start a line with ・ to make a list."
msgstr "Comece uma linha com ・ para criar uma lista."

msgid "A short line on its own becomes a heading."
msgstr "Uma linha curta e isolada se torna um subtítulo."

msgid "The imported image URL could not be created."
msgstr "Não foi possível criar a URL da imagem importada."

msgid "This image URL is not allowed."
msgstr "Esta URL de imagem não é permitida."

msgid "You are not allowed to attach images to this post."
msgstr "Você não tem permissão para anexar imagens a esta publicação."

msgid "You are not allowed to reuse this Media Library image."
msgstr "Você não tem permissão para reutilizar esta imagem da Biblioteca de Mídia."

msgid "The temporary file could not be created."
msgstr "Não foi possível criar o arquivo temporário."

msgid "The remote image could not be downloaded."
msgstr "Não foi possível baixar a imagem remota."

msgid "The remote image returned an unexpected response."
msgstr "A imagem remota retornou uma resposta inesperada."

msgid "The remote image exceeds the upload size limit."
msgstr "A imagem remota excede o limite de tamanho de upload."

msgid "The downloaded file is not a supported image."
msgstr "O arquivo baixado não é uma imagem compatível."

msgid ".md / .markdown / .txt, up to 2 MB"
msgstr ".md / .markdown / .txt, até 2 MB"

msgid "Choose a .md, .markdown, or .txt file up to 2 MB."
msgstr "Escolha um arquivo .md, .markdown ou .txt de até 2 MB."

msgid "Copy AI authoring rules"
msgstr "Copiar regras para escrever com IA"

msgid "AI authoring rules copied."
msgstr "Regras para escrever com IA copiadas."

msgid "AI authoring rules could not be copied."
msgstr "Não foi possível copiar as regras para escrever com IA."

msgid "The H1 matching the Front Matter title will be removed automatically to avoid duplication in the post body."
msgstr "O H1 que corresponde ao título do Front Matter será removido automaticamente para não duplicar o título no conteúdo da publicação."

msgid "The Front Matter title differs from the first H1. The H1 will be removed from the post body when applied."
msgstr "O título do Front Matter é diferente do primeiro H1. Ao aplicar, o H1 será removido do conteúdo da publicação."

msgid "The closing --- for Front Matter was not found."
msgstr "O --- de fechamento do Front Matter não foi encontrado."

msgid "Multiple H1 headings were found. Keep one H1 to use as the post title."
msgstr "Foram encontrados vários cabeçalhos H1. Mantenha apenas um H1 para usá-lo como título da publicação."

msgid "HTML will be inserted as text and will not run as HTML."
msgstr "O HTML será inserido como texto e não será executado como HTML."

msgid "Markdown insertion method"
msgstr "Forma de inserir o Markdown"

msgid "The Markdown import could not be completed."
msgstr "Não foi possível concluir a importação do Markdown."

msgid "Back to Markdown"
msgstr "Voltar para Markdown"

msgid "Markdown could not be converted to blocks."
msgstr "Não foi possível converter o Markdown em blocos."

msgid "Enter some Markdown."
msgstr "Insira algum conteúdo em Markdown."

msgid "Markdown file"
msgstr "Arquivo Markdown"

msgid "Load a Markdown file"
msgstr "Carregar um arquivo Markdown"

