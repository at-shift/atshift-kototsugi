msgstr "Brontekst, berichtinstellingen en controle"

msgid "Clear source"
msgstr "Brontekst wissen"

msgid "Insertion method"
msgstr "Manier van invoegen"

msgid "Importing..."
msgstr "Importeren..."

msgid "Conversion options"
msgstr "Opties voor omzetten"

msgid "Preflight checks"
msgstr "Controle vooraf"

msgid "Fix the preflight errors before continuing."
msgstr "Los de fouten uit de controle vooraf op voordat je doorgaat."

msgid "Save remote images to the Media Library"
msgstr "Externe afbeeldingen in de Mediabibliotheek opslaan"

msgid "Info"
msgstr "Info"

msgid "The post has not been saved yet."
msgstr "Het bericht is nog niet opgeslagen."

msgid "Apply post title"
msgstr "Berichttitel overnemen"

msgid "The post body was replaced with blocks."
msgstr "De berichtinhoud is vervangen door blokken."

msgid "Post settings"
msgstr "Berichtinstellingen"

