msgid "Used on the passphrase, article, review, and completion screens."
msgstr "Cette langue sera utilisée sur les écrans de saisie de la phrase secrète, de rédaction, de vérification et de confirmation."

msgid "New article"
msgstr "Nouvel article"

msgid "Create an article"
msgstr "Créer un article"

msgid "Article title"
msgstr "Titre de l'article"

msgid "Article text"
msgstr "Texte de l'article"

msgid "Write the article here"
msgstr "Écrivez l'article ici"

msgid "Writing hints"
msgstr "Conseils de rédaction"

msgid "Writing normally creates paragraphs. Use these hints only when you want more structure."
msgstr "Écrivez normalement pour créer des paragraphes. Utilisez ces conseils seulement si vous souhaitez mieux structurer l'article."

msgid "Leave a blank line between paragraphs."
msgstr "Laissez une ligne vide entre les paragraphes."

msgid "Start a line with ・ to make a list."
msgstr "Commencez une ligne par ・ pour créer une liste."

msgid "A short line on its own becomes a heading."
msgstr "Une ligne courte placée seule devient un intertitre."

msgid "The imported image URL could not be created."
msgstr "L'URL de l'image importée n'a pas pu être créée."

msgid "This image URL is not allowed."
msgstr "Cette URL d'image n'est pas autorisée."

msgid "You are not allowed to attach images to this post."
msgstr "Vous n'êtes pas autorisé à joindre des images à cette publication."

msgid "You are not allowed to reuse this Media Library image."
msgstr "Vous n'êtes pas autorisé à réutiliser cette image de la Médiathèque."

msgid "The temporary file could not be created."
msgstr "Le fichier temporaire n'a pas pu être créé."

msgid "The remote image could not be downloaded."
msgstr "L'image distante n'a pas pu être téléchargée."

msgid "The remote image returned an unexpected response."
msgstr "Le serveur de l'image distante a renvoyé une réponse inattendue."

msgid "The remote image exceeds the upload size limit."
msgstr "L'image distante dépasse la taille maximale autorisée pour les fichiers envoyés."

msgid "The downloaded file is not a supported image."
msgstr "Le fichier téléchargé n'est pas une image prise en charge."

msgid ".md / .markdown / .txt, up to 2 MB"
msgstr ".md / .markdown / .txt, jusqu'à 2 Mo"

msgid "Choose a .md, .markdown, or .txt file up to 2 MB."
msgstr "Choisissez un fichier .md, .markdown ou .txt d'une taille maximale de 2 Mo."

msgid "Copy AI authoring rules"
msgstr "Copier les consignes de rédaction pour l'IA"

msgid "AI authoring rules copied."
msgstr "Les consignes de rédaction pour l'IA ont été copiées."

msgid "AI authoring rules could not be copied."
msgstr "Les consignes de rédaction pour l'IA n'ont pas pu être copiées."

msgid "The H1 matching the Front Matter title will be removed automatically to avoid duplication in the post body."
msgstr "Le titre H1 identique au titre du Front Matter sera supprimé automatiquement afin d'éviter sa répétition dans le contenu."

msgid "The Front Matter title differs from the first H1. The H1 will be removed from the post body when applied."
msgstr "Le titre du Front Matter est différent du premier H1. Ce H1 sera supprimé du contenu lors de l'application."

msgid "The closing --- for Front Matter was not found."
msgstr "Le délimiteur de fin --- du Front Matter est introuvable."

msgid "Multiple H1 headings were found. Keep one H1 to use as the post title."
msgstr "Plusieurs titres H1 ont été trouvés. Conservez un seul H1 pour l'utiliser comme titre de la publication."

msgid "HTML will be inserted as text and will not run as HTML."
msgstr "Le code HTML sera inséré sous forme de texte et ne sera pas interprété comme du HTML."

msgid "Markdown insertion method"
msgstr "Méthode d'insertion Markdown"

msgid "The Markdown import could not be completed."
msgstr "L'importation Markdown n'a pas pu être effectuée."

msgid "Back to Markdown"
msgstr "Revenir au Markdown"

msgid "Markdown could not be converted to blocks."
msgstr "Le Markdown n'a pas pu être converti en blocs."

msgid "Enter some Markdown."
msgstr "Saisissez du Markdown."

msgid "Markdown file"
msgstr "Fichier Markdown"

msgid "Load a Markdown file"
msgstr "Charger un fichier Markdown"

msgid "Markdown file loaded."
msgstr "Fichier Markdown chargé."

msgid "Choose a Markdown file"
msgstr "Choisir un fichier Markdown"

msgid "Markdown source"
msgstr "Source Markdown"

msgid "Markdown posting"
msgstr "Publication Markdown"

msgid "Drop here"
msgstr "Déposez ici"

msgid "This code block will be inserted as a regular code block because no dedicated block is available."
msgstr "Ce bloc de code sera inséré sous forme de bloc de code standard, car aucun bloc spécifique n'est disponible."

msgid ". Check the heading hierarchy."
msgstr ". Vérifiez la hiérarchie des titres."

msgid " is followed by "
msgstr " est suivi de "

msgid "Apply featured image"
msgstr "Définir l'image mise en avant"

msgid "Error"
msgstr "Erreur"

msgid "Categories"
msgstr "Catégories"

msgid "Apply categories"
msgstr "Appliquer les catégories"

msgid "Add at cursor"
msgstr "Ajouter à la position du curseur"

msgid "Copying..."
msgstr "Copie en cours..."

msgid "The closing ``` for the code block was not found."
msgstr "Le délimiteur de fin ``` du bloc de code est introuvable."

msgid "Slug"
msgstr "Slug"

msgid "Apply slug"
msgstr "Appliquer le slug"

msgid "Loading sample..."
msgstr "Chargement de l'exemple..."

msgid "Title"
msgstr "Titre"

msgid "Tags"
msgstr "Étiquettes"

msgid "Apply tags"
msgstr "Appliquer les étiquettes"

msgid "Task lists will be converted to regular lists without preserving checkbox states."
msgstr "Les listes de tâches seront converties en listes ordinaires sans conserver l'état des cases à cocher."

msgid "Sample Markdown loaded."
msgstr "Exemple Markdown chargé."

msgid "Sample Markdown could not be loaded."
msgstr "Impossible de charger l'exemple Markdown."

msgid "Load sample Markdown"
msgstr "Charger un exemple Markdown"

msgid "Nested lists will be flattened to one level."
msgstr "Les listes imbriquées seront ramenées à un seul niveau."

msgid "The file could not be read."
msgstr "Impossible de lire le fichier."

msgid "Choose file"
msgstr "Choisir un fichier"

msgid "Insert as blocks"
msgstr "Insérer sous forme de blocs"

msgid "Blocks were inserted at the current cursor position."
msgstr "Les blocs ont été insérés à la position actuelle du curseur."

msgid "Preview"
msgstr "Aperçu"

msgid "There is no source to preview."
msgstr "Aucune source à prévisualiser."

msgid "Some post settings could not be applied for this post type or with your current permissions."
msgstr "Certains réglages n'ont pas pu être appliqués à ce type de publication ou avec vos droits actuels."

msgid "Some images or post settings could not be applied."
msgstr "Certaines images ou certains réglages de la publication n'ont pas pu être appliqués."

msgid "The draft was created, but not all conversion steps could be completed. "
msgstr "Le brouillon a été créé, mais toutes les étapes de conversion n'ont pas pu être effectuées. "

msgid "Open draft"
msgstr "Ouvrir le brouillon"

msgid "Alt text"
msgstr "Texte alternatif"

msgid " items"
msgstr " éléments"

msgid " categories or tags were created."
msgstr " catégories ou étiquettes ont été créées."

msgid " remote images will be saved to the Media Library."
msgstr " images distantes seront enregistrées dans la Médiathèque."

msgid " post settings were applied."
msgstr " réglages de la publication ont été appliqués."

msgid " existing blocks will be replaced in the editor."
msgstr " les blocs existants seront remplacés dans l'éditeur."

msgid " existing blocks: confirm replacement"
msgstr " blocs existants : confirmer le remplacement"

msgid " images could not be saved, so their remote URLs were kept in the post."
msgstr " images n'ont pas pu être enregistrées ; leurs URL distantes ont donc été conservées dans l'article."

msgid " images were saved to the Media Library."
msgstr " images ont été enregistrées dans la Médiathèque."

msgid " items to review"
msgstr " éléments à examiner"

msgid " settings to apply"
msgstr " réglages à appliquer"

msgid "Workspace"
msgstr "Espace de travail"

