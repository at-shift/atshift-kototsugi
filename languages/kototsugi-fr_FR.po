msgstr "L'article n'a pas pu être converti en contenu publiable de façon sécurisée."

msgid "Reload the page and try again."
msgstr "Rechargez la page, puis réessayez."

msgid "The configured post author is no longer available."
msgstr "L'auteur configuré n'est plus disponible."

