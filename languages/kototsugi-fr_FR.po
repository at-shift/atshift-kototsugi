msgstr "La destination de publication configurée n'est plus disponible."

msgid "The converted article contains an unsupported block."
msgstr "L'article converti contient un bloc non pris en charge."

msgid "This article was already submitted. Start a new post before submitting again."
msgstr "Cet article a déjà été envoyé. Créez un nouvel article avant de recommencer."

msgid "Enter the passphrase"
msgstr "Saisissez la phrase secrète"

msgid "Use the passphrase shared by the site administrator."
msgstr "Utilisez la phrase secrète communiquée par l'administrateur du site."

msgid "Continue"
msgstr "Continuer"

msgid "This browser stays signed in for 30 days."
msgstr "Ce navigateur restera connecté pendant 30 jours."

msgid "Quick Post is unavailable"
msgstr "La publication simplifiée est indisponible"

msgid "Sign out"
msgstr "Se déconnecter"

msgid "Article draft"
msgstr "Texte de l'article"

msgid "Write or paste your article"
msgstr "Rédigez ou collez votre article"

msgid "Type or paste an article, or open a text file. Plain text and Markdown are accepted."
msgstr "Saisissez ou collez un article, ou ouvrez un fichier texte. Le texte simple et Markdown sont acceptés."

msgid "Write or paste the article here"
msgstr "Rédigez ou collez l'article ici"

msgid "Open file"
msgstr "Ouvrir un fichier"

msgid "Add images"
msgstr "Ajouter des images"

msgid "Alternative text"
msgstr "Texte alternatif"

msgid "Remove image"
msgstr "Supprimer l'image"

