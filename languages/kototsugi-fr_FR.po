msgstr "Ouvrir l'espace de travail"

msgid "What will be saved"
msgstr "Ce qui sera enregistré"

msgid "No issues need fixing"
msgstr "Aucun problème à corriger"

msgid "Source, post settings, and review"
msgstr "Source, réglages de la publication et vérification"

msgid "Clear source"
msgstr "Effacer la source"

msgid "Insertion method"
msgstr "Méthode d'insertion"

msgid "Importing..."
msgstr "Importation en cours..."

msgid "Conversion options"
msgstr "Options de conversion"

msgid "Preflight checks"
msgstr "Vérifications préalables"

msgid "Fix the preflight errors before continuing."
msgstr "Corrigez les erreurs détectées avant de continuer."

msgid "Save remote images to the Media Library"
msgstr "Enregistrer les images distantes dans la Médiathèque"

msgid "Info"
msgstr "Informations"

msgid "The post has not been saved yet."
msgstr "L'article n'a pas encore été enregistré."

msgid "Apply post title"
msgstr "Appliquer le titre de l'article"

msgid "The post body was replaced with blocks."
msgstr "Le contenu de la publication a été remplacé par des blocs."

msgid "Post settings"
msgstr "Réglages de la publication"

msgid "Applying post settings..."
msgstr "Application des réglages de la publication..."

msgid "Excerpt"
msgstr "Extrait"

